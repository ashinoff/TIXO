# Строку подключения выдаёт PostgreSQL в Amvera
DATABASE_URL=postgresql://user:password@host:5432/database
# Укажите true, только если подключение к базе требует SSL
PGSSL=false
# Задайте эти значения в разделе «Переменные/Секреты» Amvera
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# На этот путь нужно подключить постоянный диск Amvera
UPLOAD_DIR=/data/uploads
